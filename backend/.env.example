# Puerto HTTP de la API.
PORT=3000
# URL LDAPS del controlador Samba AD; el certificado debe ser confiable.
LDAP_URL=ldaps://sdc.gestion.app:636
# Cuenta de servicio LDAP y su contraseña (no usar una cuenta Domain Admin).
LDAP_BIND_DN=CN=Administrator,CN=Users,DC=gestion,DC=app
LDAP_BIND_PASSWORD=Duoc2026
# Token Bearer para autorizar solicitudes a /api; usa un secreto aleatorio de 32+ caracteres.
API_TOKEN=8b1845edd3d9451d33cc11471a6612ef0b20265c424297db397fd1701585e290
# Tokens Bearer individuales por equipo; formato JSON: {"<deviceId-UUID>":"<token-de-32+-caracteres>"}.
AGENT_DEVICE_TOKENS={}
# Opcional: archivo JSON persistente de inventarios, heartbeats y actividad.
# AGENT_DATA_PATH=/var/lib/gestionapp/agents.json
# Duración de las sesiones del frontend en milisegundos (30 minutos).
AUTH_SESSION_TTL_MS=1800000
# Raíz del dominio y OU que la cuenta de servicio puede administrar.
LDAP_BASE_DN=DC=gestion,DC=app
LDAP_USERS_OU=OU=Usuarios,DC=gestion,DC=app
# DNs de grupos de seguridad usados para asignar el rol del frontend.
AUTH_GROUP_ADMIN_DN=CN=GG_Administradores,OU=Grupos,DC=gestion,DC=app
AUTH_GROUP_SUPERVISOR_DN=CN=GG_Supervisores,OU=Grupos,DC=gestion,DC=app
AUTH_GROUP_USER_DN=CN=GG_Usuarios,OU=Grupos,DC=gestion,DC=app
# Opcional: ruta al certificado PEM de la CA privada que firma el certificado del controlador.
LDAP_CA_CERT_PATH=/home/ubuntu/ca.pem
# Opcional: HTTPS navegador/backend. Configura ambos archivos para habilitar TLS.
# HTTPS_CERT_PATH=/etc/gestionapp/tls/cert.pem
# HTTPS_KEY_PATH=/etc/gestionapp/tls/privkey.pem
# Límite de espera LDAP en milisegundos.
LDAP_TIMEOUT_MS=5000
# Origen web permitido por CORS; reemplazar por el frontend real en producción.
CORS_ORIGIN=http://localhost:5173